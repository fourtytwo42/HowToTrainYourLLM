// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Preset {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  config      String   // JSON string of hyperparameters
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobs        Job[]    // Jobs using this preset
}

model Prompt {
  id          String   @id @default(uuid())
  name        String   @unique
  template    String   // The prompt template with variables
  description String?
  variables   String   // JSON string of required variables
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobs        Job[]    // Jobs using this prompt template
}

model Job {
  id            String   @id @default(uuid())
  status        String   // pending, running, completed, failed, cancelled
  type          String   // train, pull, test
  modelId       String?
  model         Model?   @relation(fields: [modelId], references: [id])
  presetId      String?
  preset        Preset?  @relation(fields: [presetId], references: [id])
  promptId      String?
  prompt        Prompt?  @relation(fields: [promptId], references: [id])
  dataPath      String?  // Path to training data
  outputPath    String?  // Path to model output
  error         String?  // Error message if failed
  progress      Float    @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  logs          Log[]    // Job logs
}

model Model {
  id          String   @id @default(uuid())
  name        String   @unique
  type        String   // base, custom
  size        Int      // Size in bytes
  status      String   // ready, training, error
  jobs        Job[]    // Jobs using this model
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Log {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  level     String   // INFO, WARN, ERROR
  message   String
  createdAt DateTime @default(now())
}

model Corpus {
  id        String   @id @default(uuid())
  filename  String   @unique
  size      Int
  status    String   @default("READY") // READY, PROCESSING, ERROR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromptTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  template    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Template {
  id          String   @id @default(uuid())
  name        String
  description String
  template    String
  variables   String   // JSON string of variables array
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Data {
  id          String   @id @default(uuid())
  filename    String
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
} 